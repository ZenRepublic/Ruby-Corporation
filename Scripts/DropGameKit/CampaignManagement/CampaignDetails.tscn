[sub_resource type="GDScript" id="GDScript_my0ny"]
script/source = "extends PanelContainer

@export var gate_displayable:DisplayableAsset
@export var tensor_button:LinkedButton
@export var dexscreener_button:LinkedButton

func _ready() -> void:
	gate_displayable.on_data_loaded.connect(show_inspect_button)
	tensor_button.visible=false
	dexscreener_button.visible=false

func show_inspect_button() -> void:
	if gate_displayable.asset is Token:
		dexscreener_button.link = SolanaService.account_inspector.get_inspect_link(gate_displayable.asset.mint,AccountInspector.InspectSite.DEXSCREENER)
		dexscreener_button.visible=true
	elif gate_displayable.asset is Nft or gate_displayable.asset is CoreAsset:
		tensor_button.link = SolanaService.account_inspector.get_inspect_link(gate_displayable.asset.mint,AccountInspector.InspectSite.TENSOR)
		tensor_button.visible=true
"

